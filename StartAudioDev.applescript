-- Audible, podcasts and local audio to MP3, transcripts, Ask-the-book and Yoto cards: one iTerm window, one stacked pane per service.
property projectID : "audio"

on run
	-- The repo is the folder holding this launcher, so it works in any clone or fork.
	set projectRoot to do shell script "dirname " & quoted form of (POSIX path of (path to me))

	if not iTermInstalled() then
		display alert "iTerm2 is required" message "Install it from https://iterm2.com, then run this launcher again."
		return
	end if
	set missingTools to loginShell(projectRoot, "for t in 'uv' 'npm' 'redis-server' 'ffmpeg' 'psql'; do command -v \"$t\" >/dev/null || printf \"%s \" \"$t\"; done")
	if missingTools is not "" then
		display alert ("Audio needs " & missingTools) message "Install the missing tools (they must be on your login shell's PATH), then run this launcher again."
		return
	end if

	-- Pre-launch step 1: Python dependencies
	try
		loginShell(projectRoot, "test -d .venv || uv venv --python 3.13 .venv; uv pip install -q --python .venv/bin/python -r backend/requirements-dev.txt")
	on error errorText
		display alert "Python dependencies failed" message errorText buttons {"Cancel", "Continue Anyway"} cancel button "Cancel"
	end try

	-- Pre-launch step 2: Frontend dependencies
	try
		loginShell(projectRoot, "test -d frontend/node_modules || npm install --prefix frontend")
	on error errorText
		display alert "Frontend dependencies failed" message errorText buttons {"Cancel", "Continue Anyway"} cancel button "Cancel"
	end try

	-- Pre-launch step 3: Local .env
	try
		loginShell(projectRoot, "test -f .env || cp .env.example .env")
	on error errorText
		display alert "Local .env failed" message errorText buttons {"Cancel", "Continue Anyway"} cancel button "Cancel"
	end try

	-- Pre-launch step 4: Postgres database
	try
		loginShell(projectRoot, "psql -lqt | cut -d'|' -f1 | grep -qw audio || createdb audio")
	on error errorText
		display alert "Postgres database failed" message errorText buttons {"Cancel", "Continue Anyway"} cancel button "Cancel"
	end try

	tell application "Finder" to set screenBounds to bounds of window of desktop

	tell application "iTerm"
		activate
		-- Rerunning replaces this project's window; other iTerm windows are untouched. Each pane gets Ctrl-C
		-- first: closing alone leaves servers that ignore hang-ups (redis-server) running. Loop over a snapshot:
		-- closing a window while looping over the live list shifts it, so the next window would be skipped.
		set allWindows to windows
		repeat with existingWindow in allWindows
			try
				tell current session of current tab of existingWindow to set existingTag to variable named "user.launcherProject"
				if existingTag is my projectID then
					repeat with existingSession in sessions of current tab of existingWindow
						tell existingSession to write text (character id 3) newline no
					end repeat
					delay 1.5
					close existingWindow
				end if
			end try
		end repeat

		set devWindow to (create window with default profile)
		set bounds of devWindow to {0, 0, (item 3 of screenBounds) * 0.75, item 4 of screenBounds}

		-- Redis: Celery broker on a project-specific port
		set paneRedis to current session of devWindow
		tell paneRedis
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Redis"
			set name to "Audio · Redis"
			write text "cd " & quoted form of projectRoot
			write text "export AUDIO_REDIS_PORT=${AUDIO_REDIS_PORT:-6390} AUDIO_BACKEND_PORT=${AUDIO_BACKEND_PORT:-8011} AUDIO_FRONTEND_PORT=${AUDIO_FRONTEND_PORT:-5182}"
			write text "source " & quoted form of projectRoot & "/.venv/bin/activate"
			write text "export REDIS_URL=redis://127.0.0.1:$AUDIO_REDIS_PORT" & "/0"
			write text "pids=$(lsof -t -iTCP:$AUDIO_REDIS_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || { kill $pids 2>/dev/null; sleep 0.5; pids=$(lsof -t -iTCP:$AUDIO_REDIS_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || kill -9 $pids 2>/dev/null; }; true"
			write text "redis-server --port $AUDIO_REDIS_PORT" & " --save '' --appendonly no"
		end tell
		set lastPane to paneRedis

		-- Backend: Django + Ninja API with hot reload
		tell lastPane to set paneBackend to (split horizontally with default profile)
		tell paneBackend
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Backend"
			set name to "Audio · Backend"
			write text "cd " & quoted form of (projectRoot & "/backend")
			write text "export AUDIO_REDIS_PORT=${AUDIO_REDIS_PORT:-6390} AUDIO_BACKEND_PORT=${AUDIO_BACKEND_PORT:-8011} AUDIO_FRONTEND_PORT=${AUDIO_FRONTEND_PORT:-5182}"
			write text "source " & quoted form of projectRoot & "/.venv/bin/activate"
			write text "export REDIS_URL=redis://127.0.0.1:$AUDIO_REDIS_PORT" & "/0"
			write text "pids=$(lsof -t -iTCP:$AUDIO_BACKEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || { kill $pids 2>/dev/null; sleep 0.5; pids=$(lsof -t -iTCP:$AUDIO_BACKEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || kill -9 $pids 2>/dev/null; }; true"
			write text "python manage.py migrate && python manage.py runserver 127.0.0.1:$AUDIO_BACKEND_PORT"
		end tell
		set lastPane to paneBackend

		-- Frontend: Vite dev server; proxies /api to the backend
		tell lastPane to set paneFrontend to (split horizontally with default profile)
		tell paneFrontend
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Frontend"
			set name to "Audio · Frontend"
			write text "cd " & quoted form of (projectRoot & "/frontend")
			write text "export AUDIO_REDIS_PORT=${AUDIO_REDIS_PORT:-6390} AUDIO_BACKEND_PORT=${AUDIO_BACKEND_PORT:-8011} AUDIO_FRONTEND_PORT=${AUDIO_FRONTEND_PORT:-5182}"
			write text "source " & quoted form of projectRoot & "/.venv/bin/activate"
			write text "export REDIS_URL=redis://127.0.0.1:$AUDIO_REDIS_PORT" & "/0"
			write text "pids=$(lsof -t -iTCP:$AUDIO_FRONTEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || { kill $pids 2>/dev/null; sleep 0.5; pids=$(lsof -t -iTCP:$AUDIO_FRONTEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || kill -9 $pids 2>/dev/null; }; true"
			write text "printf 'Waiting for Backend on port %s…\\n' $AUDIO_BACKEND_PORT; until nc -z 127.0.0.1 $AUDIO_BACKEND_PORT 2>/dev/null; do sleep 0.3; done"
			write text "npm run dev -- --port $AUDIO_FRONTEND_PORT"
		end tell
		set lastPane to paneFrontend

		-- Queue: Celery worker for downloads, conversions, transcription and Yoto sync
		tell lastPane to set paneQueue to (split horizontally with default profile)
		tell paneQueue
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Queue"
			set name to "Audio · Queue"
			write text "cd " & quoted form of (projectRoot & "/backend")
			write text "export AUDIO_REDIS_PORT=${AUDIO_REDIS_PORT:-6390} AUDIO_BACKEND_PORT=${AUDIO_BACKEND_PORT:-8011} AUDIO_FRONTEND_PORT=${AUDIO_FRONTEND_PORT:-5182}"
			write text "source " & quoted form of projectRoot & "/.venv/bin/activate"
			write text "export REDIS_URL=redis://127.0.0.1:$AUDIO_REDIS_PORT" & "/0"
			write text "printf 'Waiting for Redis on port %s…\\n' $AUDIO_REDIS_PORT; until nc -z 127.0.0.1 $AUDIO_REDIS_PORT 2>/dev/null; do sleep 0.3; done"
			write text "celery -A config worker --pool threads --concurrency 3 --loglevel=INFO"
		end tell
		set lastPane to paneQueue

		-- Working
		tell lastPane to set paneWorking to (split horizontally with default profile)
		tell paneWorking
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Working"
			set name to "Audio · Working"
			write text "cd " & quoted form of projectRoot
			write text "export AUDIO_REDIS_PORT=${AUDIO_REDIS_PORT:-6390} AUDIO_BACKEND_PORT=${AUDIO_BACKEND_PORT:-8011} AUDIO_FRONTEND_PORT=${AUDIO_FRONTEND_PORT:-5182}"
			write text "source " & quoted form of projectRoot & "/.venv/bin/activate"
			write text "export REDIS_URL=redis://127.0.0.1:$AUDIO_REDIS_PORT" & "/0"
			write text "git status --short --branch"
			write text "printf '%s\\n' " & quoted form of ("Create a login: python backend/manage.py createsuperuser") & " " & quoted form of ("Deploy: git push dailyoffice main")
		end tell
		set lastPane to paneWorking

		-- Leave Working selected.
		select paneWorking
	end tell

	-- Open the app in the default browser once its server answers.
	do shell script "(" & "for i in $(seq 1 240); do nc -z 127.0.0.1 5182 2>/dev/null && break; sleep 0.5; done; " & "open " & quoted form of ("http://localhost:5182" & "/") & ") >/dev/null 2>&1 &"
end run

on iTermInstalled()
	try
		do shell script "open -Ra iTerm"
		return true
	on error
		return false
	end try
end iTermInstalled

-- Runs a command in a login shell at the repo root, so tools on the user's PATH (Homebrew, nvm, uv) are found.
on loginShell(projectRoot, command)
	return do shell script "/bin/zsh -lc " & quoted form of ("cd " & quoted form of projectRoot & " && " & command)
end loginShell
