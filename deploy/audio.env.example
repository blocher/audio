DJANGO_SECRET_KEY=replace-me
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
DATABASE_URL=postgresql://audio:replace-me@127.0.0.1:5432/audio
REDIS_URL=redis://127.0.0.1:6379/5
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=audio.benlocher.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://audio.benlocher.com
AUDIO_MEDIA_ROOT=/var/lib/audio/media
PUBLIC_BASE_URL=https://audio.benlocher.com
# nginx serves media after Django checks the session (X-Accel-Redirect to an internal location).
MEDIA_ACCEL_PREFIX=/protected-media
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
YOTO_CLIENT_ID=
YOTO_CLIENT_SECRET=
