[Unit]
Description=Audio (audio.benlocher.com) Django application
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=audioshelf
Group=audioshelf
WorkingDirectory=/var/www/audio.benlocher.com/backend
EnvironmentFile=/etc/audio/audio.env
ExecStart=/var/www/audio.benlocher.com/.venv/bin/gunicorn config.asgi:application --workers 2 --worker-class uvicorn.workers.UvicornWorker --timeout 600 --bind 127.0.0.1:8008 --access-logfile /var/log/audio/access.log --error-logfile /var/log/audio/error.log
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/audio /var/log/audio

[Install]
WantedBy=multi-user.target
