[Unit]
Description=Audio background worker (downloads, conversion, transcription, Yoto sync)
After=network.target postgresql.service redis-server.service
Requires=audio.service

[Service]
Type=simple
User=audioshelf
Group=audioshelf
WorkingDirectory=/var/www/audio.benlocher.com/backend
EnvironmentFile=/etc/audio/audio.env
# Threads, not processes: the heavy work happens in ffmpeg subprocesses and network waits.
ExecStart=/var/www/audio.benlocher.com/.venv/bin/celery -A config worker --pool threads --concurrency 2 --loglevel=INFO
Restart=on-failure
RestartSec=5
# On stop, only the worker gets SIGTERM; its ffmpeg children keep going so the jobs don't fail mid-shutdown. Jobs
# that finish within the timeout complete; the rest are killed and resumed when the worker starts (core/recovery.py).
KillMode=mixed
TimeoutStopSec=30
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/audio /var/log/audio

[Install]
WantedBy=multi-user.target
