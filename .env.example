DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5182
DATABASE_URL=postgresql://localhost:5432/audio
REDIS_URL=redis://127.0.0.1:6390/0
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
AUDIO_MEDIA_ROOT=backend/media
# Folders the server may import from directly (local dev only), comma separated
LOCAL_IMPORT_ROOTS=~/Music,~/Downloads,~/Desktop
PUBLIC_BASE_URL=http://localhost:5182
# Optional; can also be set in Settings in the app
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Yoto app from dashboard.yoto.dev (confidential client). Redirect URL: <PUBLIC_BASE_URL>/api/yoto/callback
YOTO_CLIENT_ID=
YOTO_CLIENT_SECRET=
