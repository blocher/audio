{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5182
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend",
        "--",
        "--port",
        "5183"
      ],
      "port": 5183
    },
    {
      "name": "frontend-pwa",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "frontend",
        "--",
        "--port",
        "5184",
        "--strictPort"
      ],
      "port": 5184
    },
    {
      "name": "backend",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "backend/manage.py",
        "runserver",
        "127.0.0.1:8011"
      ],
      "port": 8011
    },
    {
      "name": "redis",
      "runtimeExecutable": "redis-server",
      "runtimeArgs": [
        "--port",
        "6390",
        "--save",
        "",
        "--appendonly",
        "no"
      ],
      "port": 6390
    }
  ]
}
